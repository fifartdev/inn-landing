# Tracking pixels — copy this file to .env.local and fill in your IDs.
# .env.local is gitignored and never committed.
#
# In production: set these in your Vercel/Netlify dashboard,
# then click "Redeploy" (no git push needed).
#
# Leave a value empty to disable that pixel.

NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# Google Sheets webhook (Apps Script Web App URL)
GOOGLE_SHEET_WEBHOOK_URL=
